rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-organisation billing records.
    match /organizations/{orgId}/invoices/{invoiceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Seat list, including member email addresses.
    match /organizations/{orgId}/members/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /organizations/{orgId}/settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
