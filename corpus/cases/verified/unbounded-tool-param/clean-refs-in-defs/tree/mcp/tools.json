{
  "$defs": {
    "RepoSlug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,39}/[a-z0-9._-]{1,100}$",
      "maxLength": 140
    },
    "BranchName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,79}$",
      "maxLength": 80
    },
    "PageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "tools": [
    {
      "name": "list_commits",
      "description": "Lists commits on a branch.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "branch"],
        "properties": {
          "repo": { "$ref": "#/$defs/RepoSlug" },
          "branch": { "$ref": "#/$defs/BranchName" },
          "page_size": { "$ref": "#/$defs/PageSize" }
        }
      }
    },
    {
      "name": "compare_branches",
      "description": "Diffs two branches in one repository.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "base", "head"],
        "properties": {
          "repo": { "$ref": "#/$defs/RepoSlug" },
          "base": { "$ref": "#/$defs/BranchName" },
          "head": { "$ref": "#/$defs/BranchName" }
        }
      }
    }
  ]
}
