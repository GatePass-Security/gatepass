{
  "tools": [
    {
      "name": "export_rows",
      "description": "Export rows from a reporting table since a given date.",
      "endpoint": "POST /tools/export_rows",
      "input_schema": {
        "type": "object",
        "required": ["table", "since"],
        "properties": {
          "table": {
            "type": "string",
            "enum": ["invoices", "customers", "line_items"]
          },
          "since": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 5000 }
        }
      }
    }
  ]
}
