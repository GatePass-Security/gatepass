{
  "manifest_version": 3,
  "name": "Inbox Copilot",
  "version": "1.4.2",
  "description": "Side-panel assistant that summarises mail threads.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://mail.example.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Inbox Copilot"
  }
}
