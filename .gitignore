# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
# ...but corpus fixtures and the eval repo INTENTIONALLY contain dist/build bundles with
# planted secrets (that's what the exposed-secret detector is tested against). Never ignore them.
!corpus/**/dist/
!corpus/**/build/

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Scan artifacts
*.findings.json
/tmp-scan/

# Credentials — never commit key material (a GitHub App key leaked here once; rotated)
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# VSIX builds
*.vsix

# Benchmark reports (generated)
benchmark/reports/


#omo
.omo/run-continuation/
# Research survey working output (large; regenerate with pnpm research:scan-mcp)
research/scan-log.txt

# Survey raw data names affected repositories with exact file:line of UNFIXED
# vulnerabilities. Kept local for responsible disclosure only — never published.
research/out/mcp-survey-raw.json
research/out/verification.json
research/out/disclosure-worklist.md
# Same rule for the outreach list derived from it (pnpm research:leads): it names
# vulnerable third-party repos, plus GitHub owner metadata about real people.
research/out/leads.json
research/out/leads-gh-cache.json
.gstack/
