# Database
DATABASE_URL=postgres://gatepass:gatepass@localhost:5432/gatepass
REDIS_URL=redis://localhost:6379

# GitHub App (dev credentials — private key stored at the path below)
# Optional for scanning: without these the API fetches repositories anonymously, which reaches
# public repos only and is capped at GitHub's 60 requests/hour per IP. With them it reaches
# whatever the App was installed on, at 5,000/hour, and can open fix PRs.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Public repositories a fresh deployment scans once at boot (comma-separated `owner/repo`), so
# the dashboard opens with real results instead of an empty state. Each is fetched over the
# network, which makes every finding checkable against github.com at the commit that was
# scanned. Leave several in the list: repositories that come back clean are the precision
# evidence, and the corpus — built from planted vulnerabilities — cannot provide it.
# Set to `off` to skip; if every fetch fails, the bundled fixture is scanned and the page says so.
GATEPASS_DEMO_REPOS=vercel/ai,openai/openai-agents-python,modelcontextprotocol/servers,punkpeye/fastmcp,sooperset/mcp-atlassian,microsoft/playwright-mcp,browserbase/mcp-server-browserbase

# LLM gateway (research-tier semantic analysis via NVIDIA NIM GLM 5.2)
# Get a key from https://build.nvidia.com/ — format: nvapi-…
NVIDIA_API_KEY=
GATEPASS_LLM_ENABLED=true

# Introspection benchmark
#   pnpm benchmark
# Scans the test repo at ~/documents/YC/gate_pass_test_repo/ (or GATE_PASS_TEST_REPO)
# and reports per-class TP/FP. When NVIDIA_API_KEY is set above, the benchmark
# uses runScanAsync to exercise the LLM gateway for confidence refinement.
# Both paths (with and without the key) produce the same TP/FP results — the
# key only affects research-tier confidence scoring.

# Write credentials for the two endpoints no browser session covers.
# BOTH FAIL CLOSED — leave one unset and that route rejects every request.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Enables POST /v1/runner/results. Comma-separated "orgId:token" pairs; the org a
# runner may write to is a property of its token, never of the payload.
GATEPASS_RUNNER_TOKENS=
# Enables POST /v1/benchmark/publish (operator action — the benchmark is global).
GATEPASS_ADMIN_TOKEN=

# Dashboard origin, echoed by the API's root status response (e.g. https://gatepass.vercel.app).
# Omitted from the response when unset rather than guessing at localhost.
GATEPASS_WEB_URL=

# ── Sign-in (GitHub OAuth + sessions) ────────────────────────────────────────
# All three are needed for GitHub sign-in. Without them the login page says so
# plainly instead of offering a button that dead-ends.
# Generate SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must match the callback URL registered on the GitHub OAuth app:
#   <dashboard origin>/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
SESSION_SECRET=

# ── WHO MAY SIGN IN, AND WHAT THEY SEE ───────────────────────────────────────
#
# The default and intended model: an organization installs the Gatepass App on
# their GitHub org, and the people who may use Gatepass for a repository are
# exactly the people GitHub already says may work on that repository. There is no
# invite list to keep in sync — a second list is how someone keeps access after
# they have been removed from the org.
#
# Concretely: at sign-in Gatepass asks GitHub which installations of its App this
# account can reach, and which repositories each installation shares with them.
# Those repositories are what they see; every other repository in the org is not
# in their dashboard, their scan history, their findings, or their SARIF.
#
# On automatically whenever OAuth sign-in works. Set to 0 for the older
# single-org posture below (a local install, an air-gapped evaluation).
GATEPASS_GITHUB_ACCESS=

# Seconds a resolved access grant is cached before GitHub is asked again.
# Default 600. This is how long somebody removed from a repository keeps seeing
# it, so it is minutes rather than the session's days.
GATEPASS_ACCESS_TTL_SEC=

# PER-REPOSITORY ACCESS NEEDS A GITHUB APP, NOT A CLASSIC OAUTH APP.
# Only a GitHub App's user tokens can call GET /user/installations, which is what
# makes GitHub itself compute "repositories this installation covers that this
# user may also see". A classic OAuth App falls back to: org membership for the
# tenant list, plus a per-repository collaborator check made with the App
# installation token below — and with no installation token either, to org-wide
# access. /v1/auth/me reports which, per org, as `accessGranularity`.

# ── The single-org fallback ──────────────────────────────────────────────────
# Everything below governs a deployment with GATEPASS_GITHUB_ACCESS=0, and is
# also the escape hatch for an operator who needs in without a GitHub install.

# The org a successful sign-in belongs to. Server-side on purpose — it is never
# read from the request, because a session's tenant must not be something the
# person holding it chose. Defaults to "demo".
#
# When GitHub-derived access IS on, GATEPASS_GITHUB_ORG (below) instead pins the
# deployment to one GitHub organization: a user who reaches five installations
# still only gets that one.
GATEPASS_SESSION_ORG=

# With GATEPASS_GITHUB_ACCESS=0, set at least one of the next two or every
# sign-in is refused.
#
# This is not optional paranoia: a GitHub OAuth app completes the flow for ANY
# GitHub account in existence. There is no allow-list inside OAuth itself. These
# two settings are the only thing standing between "signed in with GitHub" and
# "may read this organization's vulnerabilities", so a deployment with neither
# admits nobody rather than everybody.

# GitHub organization whose ACTIVE membership admits a user and sets their role:
# an owner becomes "admin", a member "member". Anyone else — including a pending
# invitation, and including the case where the membership lookup fails — is
# refused a session outright.
GATEPASS_GITHUB_ORG=

# Named GitHub logins, for a deployment with no organization to check against (a
# personal account) or for someone outside the org. Comma-separated; each entry
# is "login" or "login:role".
#   GATEPASS_ALLOWED_LOGINS=octocat,hubot:admin,contractor:viewer
# An entry naming a role that is not admin|member|viewer is dropped, so a typo
# stops that person signing in rather than silently granting them read access.
#
# These are consulted only after GitHub-derived access has produced nothing, so
# an allow-listed operator can still get in on a deployment where the App is not
# installed anywhere — but they get the unrestricted single-org view, not a
# repository-scoped one.
GATEPASS_ALLOWED_LOGINS=

# Role for an allow-list entry that names none. Defaults to "viewer" — a
# deployment that has not said how to tell an owner from a stranger hands out
# read-only sessions rather than trusting. admin | member | viewer
GATEPASS_DEFAULT_ROLE=

# ── Local password accounts (no GitHub required) ─────────────────────────────
# A sign-in for somebody who should be able to look at this deployment without
# first authorizing an OAuth app against their personal GitHub account — a
# reviewer, an auditor, an investor. They sign in, look around, and connect
# GitHub from inside the dashboard (Settings → GitHub account) if they want to.
#
# Comma-separated `login:hash` or `login:hash:role`. THE PASSWORD IS NEVER HERE,
# only a scrypt hash — a leaked .env or a `ps` listing does not hand anyone a
# password that may be reused somewhere else. Generate an entry with:
#
#   pnpm --filter @gatepass/api hash-password admin admin
#
# (password is read from stdin, never from argv, so it stays out of your shell
# history and out of every other process's view of the command line.)
#
# The role defaults to `viewer` — read-only, which is what "have a look at this"
# actually needs. `member` adds scanning and disputing. `admin` adds org
# settings, gate policy, evidence export and opening fix PRs against real
# repositories, which is more than a reviewer usually wants to be able to do by
# accident.
#
# These are SHARED credentials with no second factor and no expiry of their own.
# Rotate them when whoever you gave them to is done.
GATEPASS_LOCAL_USERS=

# LOCAL DEVELOPMENT ONLY. Enables POST /v1/auth/dev-session, which issues a real
# signed admin session to anyone who asks, with no GitHub involved. It requires
# this flag AND a non-production NODE_ENV, so it is off by default everywhere and
# CANNOT be turned on in production — the API refuses regardless of this value
# when NODE_ENV=production.
#
# You do not normally set this by hand: `pnpm --filter @gatepass/api dev` turns it
# on, and `pnpm --filter @gatepass/api start` (what render.yaml runs) does not.
GATEPASS_DEV_AUTH=

# Object storage (scan artifacts)
S3_BUCKET=
S3_REGION=

# ── Datastore ────────────────────────────────────────────────────────────────
# MongoDB holds everything that must survive a restart: organizations, scans,
# findings, repositories, revoked sessions, GitHub access grants, and local
# password accounts.
#
# Unset and with no DATABASE_URL, the API runs in memory and says so at boot —
# fine for local development, and honest that every scan dies with the process.
#
# A URI that cannot be reached STOPS the process. Falling back to memory would
# mean the API comes up, answers every request, and silently writes a customer's
# scan history into a Map — the worst of the three possible outcomes.
#
# Single-quote it: an Atlas password can contain shell metacharacters, and
# `set -a; . .env` would mangle it into a mysterious authentication failure.
MONGODB_URI=
# Database name inside the cluster. Defaults to whatever the URI path names.
MONGODB_DB=
