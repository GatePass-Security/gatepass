# Database
DATABASE_URL=postgres://gatepass:gatepass@localhost:5432/gatepass
REDIS_URL=redis://localhost:6379

# GitHub App (dev credentials — private key stored at the path below)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# LLM gateway (research-tier semantic analysis via NVIDIA NIM GLM 5.2)
# Get a key from https://build.nvidia.com/ — format: nvapi-…
NVIDIA_API_KEY=
GATEPASS_LLM_ENABLED=true

# Introspection benchmark
#   pnpm benchmark
# Scans the test repo at ~/documents/YC/gate_pass_test_repo/ (or GATE_PASS_TEST_REPO)
# and reports per-class TP/FP. When NVIDIA_API_KEY is set above, the benchmark
# uses runScanAsync to exercise the LLM gateway for confidence refinement.
# Both paths (with and without the key) produce the same TP/FP results — the
# key only affects research-tier confidence scoring.

# Write credentials for the two endpoints no browser session covers.
# BOTH FAIL CLOSED — leave one unset and that route rejects every request.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Enables POST /v1/runner/results. Comma-separated "orgId:token" pairs; the org a
# runner may write to is a property of its token, never of the payload.
GATEPASS_RUNNER_TOKENS=
# Enables POST /v1/benchmark/publish (operator action — the benchmark is global).
GATEPASS_ADMIN_TOKEN=

# Object storage (scan artifacts)
S3_BUCKET=
S3_REGION=
